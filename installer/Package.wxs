<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for Instance Manager for WSL (WiX Toolset 5). Built by package.cmd, which passes:
    Version  product version, from CMake's project(VERSION)
    BinDir   folder holding the Release wslmgr.exe and wslmgr-gui.exe

  Installs to %LOCALAPPDATA%\Programs\WSL Manager without elevation, adds Start menu
  and/or desktop shortcuts for the GUI (the user chooses) and puts the folder on the
  user's PATH for wslmgr.exe.
  Uninstalling leaves the user's settings (HKCU\Software\WslManager\DefaultRoot)
  and, of course, their WSL instances and backups alone.

  The UI is a welcome page followed by the GPL licence (License.rtf, generated from
  LICENSE by make-license-rtf.ps1), which must be accepted before installing, and a
  page with the shortcut choices.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Instance Manager for WSL"
           Manufacturer="Greg Silber"
           Version="$(Version)"
           UpgradeCode="{2508E9F8-6F55-4F08-B551-56CE19DC8876}"
           Scope="perUser"
           Compressed="yes">
    <SummaryInformation Description="Instance Manager for WSL $(Version)" />

    <!-- Installing any version replaces whatever version is already installed. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Instance Manager for WSL is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Welcome -> Licence (must accept) -> Shortcuts -> Ready -> Progress -> Finished.
         This is WiX's InstallDir dialog set with the folder-choice page replaced by
         ShortcutsDlg: a per-user tool lives in the standard per-user programs folder. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10"
               Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="10"
               Condition="NOT Installed" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose where to add shortcuts to Instance Manager for WSL." />
        <Control Id="StartMenu" Type="CheckBox" X="20" Y="60" Width="330" Height="18" CheckBoxValue="1"
                 Property="STARTMENUSHORTCUT" Text="Add a shortcut to the &amp;Start menu" />
        <Control Id="Desktop" Type="CheckBox" X="20" Y="82" Width="330" Height="18" CheckBoxValue="1"
                 Property="DESKTOPSHORTCUT" Text="Add a shortcut to the &amp;desktop" />
        <Control Id="Note" Type="Text" X="20" Y="112" Width="330" Height="30" NoPrefix="yes"
                 Text="Either way, the wslmgr command works in any new terminal." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <!-- Shortcut choices. A Start menu shortcut is on and a desktop one off by default
         (msiexec ... STARTMENUSHORTCUT="" DESKTOPSHORTCUT=1 for a silent install).
         An upgrade keeps the previous choices: it finds them in the registry values
         that the shortcut components below leave behind. -->
    <Property Id="STARTMENUSHORTCUT" Value="1" Secure="yes" />
    <Property Id="PREVIOUSNOSTARTMENU" Secure="yes">
      <RegistrySearch Id="NoStartMenuSearch" Root="HKCU" Key="Software\WslManager\Installer"
                      Name="NoStartMenuShortcut" Type="raw" />
    </Property>
    <SetProperty Id="STARTMENUSHORTCUT" Value="{}" After="AppSearch" Sequence="first"
                 Condition="PREVIOUSNOSTARTMENU" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes">
      <RegistrySearch Id="DesktopSearch" Root="HKCU" Key="Software\WslManager\Installer" Name="DesktopShortcut"
                      Type="raw" />
    </Property>
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Property Id="ARPCOMMENTS" Value="Create, back up, copy, move and remove WSL instances." />
    <Property Id="ARPURLINFOABOUT" Value="https://www.gnu.org/licenses/gpl-3.0.html" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Settings -> Apps shows the app's icon (package.cmd runs from the repository root). -->
    <Icon Id="AppIcon" SourceFile="src\gui\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="WSL Manager" />
      </Directory>
    </StandardDirectory>

    <!-- Files under the user profile need a per-user registry value as their key
         path, and every folder created there must be removed on uninstall. WiX
         can't derive GUIDs for such components, so they are fixed here: never
         change them, or upgrades will orphan the old files. -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="GuiComponent" Guid="{582C5000-C9FB-413F-91C9-4DD874253096}">
        <File Id="GuiExe" Source="$(BinDir)\wslmgr-gui.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\WslManager\Installer" Name="Gui" Type="integer" Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="CliComponent" Guid="{7063774A-E0DA-4C9E-B22A-14E915DBA8AD}">
        <File Id="CliExe" Source="$(BinDir)\wslmgr.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\WslManager\Installer" Name="Cli" Type="integer" Value="1"
                       KeyPath="yes" />
        <!-- Appends the install folder to the user's PATH; removed again on uninstall. -->
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no"
                     Permanent="no" />
      </Component>
    </ComponentGroup>

    <!-- Exactly one of StartMenuComponent and NoStartMenuComponent is installed, so an
         upgrade can tell "turned off" apart from "first install". -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuComponent" Condition="STARTMENUSHORTCUT">
        <Shortcut Id="GuiShortcut" Name="Instance Manager for WSL" Description="Create, back up, copy, move and remove WSL instances"
                  Target="[INSTALLFOLDER]wslmgr-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\WslManager\Installer" Name="Shortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Component Id="NoStartMenuComponent" Directory="INSTALLFOLDER" Condition="NOT STARTMENUSHORTCUT">
      <RegistryValue Root="HKCU" Key="Software\WslManager\Installer" Name="NoStartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopComponent" Condition="DESKTOPSHORTCUT">
        <Shortcut Id="DesktopShortcut" Name="Instance Manager for WSL"
                  Description="Create, back up, copy, move and remove WSL instances"
                  Target="[INSTALLFOLDER]wslmgr-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\WslManager\Installer" Name="DesktopShortcut" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Instance Manager for WSL">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="NoStartMenuComponent" />
      <ComponentRef Id="DesktopComponent" />
    </Feature>
  </Package>
</Wix>
