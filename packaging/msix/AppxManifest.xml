<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store. scripts\make-msix.ps1 fills in
  {VERSION} (from CMake's project(VERSION), plus a fourth part, 0) and {PUBLISHER}.

  The Identity Name and Publisher, and PublisherDisplayName, must match Partner
  Center (Product management -> Product identity) exactly, or the upload is refused.

  Virtualization: MSIX flexible virtualization (Windows 11 and later) leaves exactly
  one registry key unvirtualized, WSL's per-user registration
  HKCU\Software\Microsoft\Windows\CurrentVersion\Lxss, which the WSL service reads
  from outside the package. Rename edits DistributionName there (wsl.exe has no
  rename command), and Restore/Copy set DefaultUid, Flavor and OsVersion on the
  instance they just registered. Everything else stays virtualized: the app's own
  settings (HKCU\Software\WslManager) are private to the package and removed on
  uninstall, and file-system virtualization is fully on (the app refuses to create
  instances or backups under AppData; see RejectPrivateLocation in Wsl.cpp).

  MinVersion is Windows 11 because Windows 10 ignores the flexible declaration.
  The ExcludedKey needs the unvirtualizedResources restricted capability.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop virtualization rescap">

  <Identity Name="GregSilber.InstanceManagerforWSL"
            Publisher="{PUBLISHER}"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Instance Manager for WSL</DisplayName>
    <PublisherDisplayName>Greg Silber</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Lxss</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="wslmgr-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Instance Manager for WSL"
                          Description="Create, back up, copy, move and remove WSL instances."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- The command-line tool. The Store allows one app per package, so wslmgr.exe
           isn't an app of its own: this alias, on the GUI app, runs it, and puts
           "wslmgr" on every terminal's path. (Windows Terminal does the same for wt.exe.) -->
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="wslmgr.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="wslmgr.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
