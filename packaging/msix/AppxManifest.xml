<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store. scripts\make-msix.ps1 fills in
  {VERSION} (from CMake's project(VERSION), plus a fourth part, 0) and {PUBLISHER}.

  The Identity Name and Publisher, and PublisherDisplayName, must match Partner
  Center (Product management -> Product identity) exactly, or the upload is refused.

  Registry and file-system write virtualization are off (unvirtualizedResources):
  the app edits WSL's per-user registration under HKCU\...\Lxss, and creates
  instance folders that wsl.exe and the WSL service, running outside the package,
  must see. With virtualization on, those writes would land in a private copy that
  only this package sees.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop desktop6 rescap">

  <Identity Name="GregSilber.InstanceManagerforWSL"
            Publisher="{PUBLISHER}"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Instance Manager for WSL</DisplayName>
    <PublisherDisplayName>Greg Silber</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="wslmgr-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Instance Manager for WSL"
                          Description="Create, back up, copy, move and remove WSL instances."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- The command-line tool. The Store allows one app per package, so wslmgr.exe
           isn't an app of its own: this alias, on the GUI app, runs it, and puts
           "wslmgr" on every terminal's path. (Windows Terminal does the same for wt.exe.) -->
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="wslmgr.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="wslmgr.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
