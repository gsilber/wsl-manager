#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"  // generated by scripts/make-icon.ps1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WSL Manager"
            VALUE "FileVersion", "1.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Greg Silber. Licensed under GPL-3.0-or-later."
            VALUE "ProductName", "WSL Manager"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Popup menus only: the window has a ribbon instead of a menu bar.
// 0 = the File tab's menu, 1 = the instance list's context menu.
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Instance...\tCtrl+N", IDM_NEW
        MENUITEM "Default &Storage Folder...", IDM_DEFAULTROOT
        MENUITEM SEPARATOR
        MENUITEM "&Refresh\tF5", IDM_REFRESH
        MENUITEM "Shut &Down WSL", IDM_SHUTDOWN
        MENUITEM SEPARATOR
        MENUITEM "&About WSL Manager", IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Instance"
    BEGIN
        MENUITEM "Open &Shell\tEnter", IDM_SHELL
        MENUITEM "Open Storage &Folder", IDM_OPENFOLDER
        MENUITEM SEPARATOR
        MENUITEM "&Back Up...", IDM_BACKUP
        MENUITEM "&Copy...", IDM_CLONE
        MENUITEM "&Move Storage...", IDM_MOVE
        MENUITEM "Re&name...", IDM_RENAME
        MENUITEM "Set Default &User...", IDM_DEFAULTUSER
        MENUITEM "&Protected", IDM_PROTECT
        MENUITEM SEPARATOR
        MENUITEM "Set as &Default", IDM_SETDEFAULT
        MENUITEM "S&top", IDM_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Remove...\tDel", IDM_REMOVE
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "N", IDM_NEW, VIRTKEY, CONTROL
    VK_F5, IDM_REFRESH, VIRTKEY
    "F", IDM_TAB_FILE, VIRTKEY, ALT
END

// Dialogs use Fluent spacing: 12 DLU margins, a section heading per group, and a
// footer band (painted by ui::ThemeDialog) holding the buttons.

IDD_CREATE DIALOGEX 0, 0, 340, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New WSL Instance"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Source", IDC_HEADING_SOURCE, 12, 10, 200, 11
    AUTORADIOBUTTON "&Clean install from the online catalog", IDC_SRC_CLEAN, 12, 26, 210, 12, WS_GROUP | WS_TABSTOP
    COMBOBOX        IDC_ONLINE, 26, 40, 196, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Download from the &web", IDC_WEBDL, 230, 41, 98, 12, WS_TABSTOP
    AUTORADIOBUTTON "Restore from a &backup file (.tar, .tar.gz, .tar.xz, .vhdx)", IDC_SRC_BACKUP, 12, 60, 300, 12
    EDITTEXT        IDC_BACKUPFILE, 26, 74, 244, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rowse...", IDC_BACKUPBROWSE, 274, 73, 54, 16, WS_TABSTOP
    AUTORADIOBUTTON "Co&py an existing instance", IDC_SRC_CLONE, 12, 94, 210, 12
    COMBOBOX        IDC_CLONESRC, 26, 108, 196, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Instance", IDC_HEADING_INSTANCE, 12, 132, 200, 11, WS_GROUP
    LTEXT           "&Name:", IDC_STATIC, 12, 150, 60, 8
    EDITTEXT        IDC_NAME, 76, 148, 146, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "WSL &version:", IDC_STATIC, 232, 150, 48, 8
    COMBOBOX        IDC_VERSION, 284, 148, 44, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Storage &location:", IDC_STATIC, 12, 170, 62, 8
    EDITTEXT        IDC_LOCATION, 76, 168, 194, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Br&owse...", IDC_LOCBROWSE, 274, 167, 54, 16, WS_TABSTOP
    LTEXT           "The instance's virtual disk is stored in this folder. You can move it later.", IDC_HINT_CREATE, 76, 186, 252, 8

    DEFPUSHBUTTON   "Create", IDOK, 214, 214, 54, 16, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 274, 214, 54, 16
END

IDD_BACKUP DIALOGEX 0, 0, 300, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Back Up Instance"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Instance:", IDC_STATIC, 12, 12, 56, 8
    LTEXT           "", IDC_INFO, 72, 12, 216, 8, SS_ENDELLIPSIS
    LTEXT           "&Format:", IDC_FORMATLABEL, 12, 31, 56, 8
    COMBOBOX        IDC_FORMAT, 72, 29, 158, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Backup &file:", IDC_FILELABEL, 12, 51, 56, 8
    EDITTEXT        IDC_FILE, 72, 49, 158, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rowse...", IDC_FILEBROWSE, 234, 48, 54, 16, WS_TABSTOP
    LTEXT           "A running instance is stopped while it is backed up.", IDC_HINT_BACKUP, 72, 67, 216, 8
    DEFPUSHBUTTON   "Back Up", IDOK, 174, 98, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 98, 54, 16
END

IDD_MOVE DIALOGEX 0, 0, 300, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Move Instance Storage"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Instance:", IDC_STATIC, 12, 12, 58, 8
    LTEXT           "", IDC_INFO, 72, 12, 216, 8, SS_ENDELLIPSIS
    LTEXT           "Current location:", IDC_STATIC, 12, 26, 58, 8
    LTEXT           "", IDC_CURRENT, 72, 26, 216, 8, SS_PATHELLIPSIS
    LTEXT           "&New location:", IDC_STATIC, 12, 45, 58, 8
    EDITTEXT        IDC_LOCATION, 72, 43, 158, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rowse...", IDC_LOCBROWSE, 234, 42, 54, 16, WS_TABSTOP
    LTEXT           "The virtual disk is moved to this folder. A running instance is stopped first.", IDC_HINT_MOVE, 72, 61, 216, 16
    DEFPUSHBUTTON   "Move", IDOK, 174, 94, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 94, 54, 16
END

IDD_REMOVE DIALOGEX 0, 0, 300, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remove Instance"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_INFO, 12, 10, 276, 26
    AUTOCHECKBOX    "&Back up the instance before removing it", IDC_BACKUPFIRST, 12, 40, 220, 12, WS_TABSTOP
    LTEXT           "&Format:", IDC_FORMATLABEL, 26, 59, 44, 8
    COMBOBOX        IDC_FORMAT, 72, 57, 158, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Backup f&ile:", IDC_FILELABEL, 26, 79, 44, 8
    EDITTEXT        IDC_FILE, 72, 77, 158, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rowse...", IDC_FILEBROWSE, 234, 76, 54, 16, WS_TABSTOP
    AUTOCHECKBOX    "&Delete the storage folder if it is left empty", IDC_DELETEFOLDER, 12, 98, 220, 12, WS_TABSTOP
    PUSHBUTTON      "Remove", IDOK, 174, 126, 54, 16
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 234, 126, 54, 16
END

IDD_TEXT DIALOGEX 0, 0, 250, 84
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROMPT, 12, 12, 226, 8
    EDITTEXT        IDC_TEXT, 12, 25, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 124, 60, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 184, 60, 54, 16
END
